# ==========================================
# Cloud Deployment Configuration (Option B)
# Vercel + Neon PostgreSQL + Upstash Redis
# ==========================================

# 1. Neon PostgreSQL Connection String (choose closest region, e.g., ap-southeast-1, us-east-1)
# Use the pooled connection string (with -pooler) for serverless environments.
DATABASE_URL="postgresql://<username>:<password>@ep-<endpoint-id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# 2. Upstash Redis Connection String (TLS enabled with rediss://)
# Choose the same region as your database for lowest latency.
REDIS_URL="rediss://default:<password>@<endpoint-id>.<region>.upstash.io:6379"

# 3. Base URL / Origin (Your Vercel app domain)
BASE_URL="https://your-project-name.vercel.app"

# 4. Secret used for signing anti-proxy device cookies
COOKIE_SECRET="super-secret-random-key-change-this"

# 5. QR Timing settings
QR_ROTATION_SECONDS=20
QR_TOKEN_TTL_SECONDS=25

# 6. Local Dev Settings (optional)
PORT=3000
HOST="0.0.0.0"
